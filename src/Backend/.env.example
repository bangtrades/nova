# Database — SQLite for local dev, Postgres for production
# Local (SQLite):
DATABASE_URL="file:./nova.db"
# Production (Postgres):
# DATABASE_URL="postgresql://nova:password@localhost:5432/nova_dev"

# JWT (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production!!

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Cloudflare R2 (Asset Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=nova-assets
R2_PUBLIC_URL=https://assets.nova-app.com

# OpenAI (For LLM proxy and OAuth)
OPENAI_API_KEY=your-openai-api-key-for-proxy
OPENAI_OAUTH_CLIENT_ID=your-oauth-client-id
OPENAI_OAUTH_CLIENT_SECRET=your-oauth-client-secret
OPENAI_OAUTH_REDIRECT_URI=https://api.nova-app.com/api/v1/oauth/callback
