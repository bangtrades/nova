// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  // SQLite for local dev, switch to "postgresql" for production
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  appleId           String?             @unique
  email             String?             @unique
  displayName       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  childProfiles     ChildProfile[]
  subscription      Subscription?
  llmProviders      LLMProvider[]
  learningPaths     LearningPath[]
  lessons           Lesson[]
  urlIngests        UrlIngest[]

  @@index([appleId])
  @@index([email])
  @@map("users")
}

model ChildProfile {
  id                String              @id @default(uuid())
  userId            String
  name              String
  birthDate         DateTime
  avatarUrl         String?
  currentStage      Int                 @default(1)
  // S10-05: IANA timezone for DST-safe time-of-day context (e.g. "America/New_York").
  // Never store a UTC offset here — offsets shift twice a year under DST.
  ianaTimezone      String              @default("UTC")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningSessions  LearningSession[]
  earnedBadges      EarnedBadge[]
  sparkyConversations SparkyConversation[]
  childConcepts     ChildConcept[]
  engagementProfile EngagementProfile?   // S10-03
  parentGuidance    ParentGuidance?      // S10-04

  @@index([userId])
  @@map("child_profiles")
}

// S10-03: Engagement Profile — per-child behavioral signals derived from CardInteractions.
// - Raw counters (totalSessions, totalInteractions, totalDurationMs, frustration/flow counts,
//   streaks) are stored in the clear: they are not child-identifying on their own.
// - `cardTypeStatsEncrypted` and `topicAffinitiesEncrypted` are AES-256-GCM encrypted JSON
//   blobs (via services/oauth/tokenEncryption) because they profile what the child prefers
//   and engages with — treated as COPPA-sensitive at rest.
model EngagementProfile {
  id                       String              @id @default(uuid())
  childId                  String              @unique
  totalSessions            Int                 @default(0)
  totalInteractions        Int                 @default(0)
  totalDurationMs          Int                 @default(0)
  frustrationEventCount    Int                 @default(0)
  flowEventCount           Int                 @default(0)
  currentStreak            Int                 @default(0)  // consecutive correct answers (resets on wrong)
  longestStreak            Int                 @default(0)
  cardTypeStatsEncrypted   String?              // encrypted JSON: Record<CardType,{count,totalDurationMs,completionCount}>
  topicAffinitiesEncrypted String?              // encrypted JSON: Record<Domain,{count,totalDurationMs}>
  lastInteractionAt        DateTime?
  lastComputedAt           DateTime            @default(now())
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  // Relations
  child                    ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("engagement_profiles")
}

// S10-04: Parent Guidance — per-child parental controls consumed by the content
// pipeline at generation time. 1:1 with ChildProfile.
// - `topicFocus` / `topicAvoid` are JSON string arrays of topic/tag names.
//   `topicFocus` biases decomposition + card generation TOWARD these topics;
//   `topicAvoid` is a hard filter (the pipeline drops or skips concepts that
//   match).
// - `difficultyOffset` is clamped to [-2, +2] at the service layer; it is
//   added to the model's baseline difficulty estimate for the child's age.
// - `contentBoundaries` is a JSON blob with optional `disallowedKeywords`
//   (string[]) and `allowedTags` (string[]) so we can extend without a
//   migration. Not encrypted — these are parent preferences, not child
//   behavioral data.
// - `dailySessionLimitMinutes` / `singleSessionLimitMinutes` are nullable;
//   null means "no limit set".
// - `updatedByUserId` tracks which parent made the last change (audit trail).
model ParentGuidance {
  id                       String              @id @default(uuid())
  childId                  String              @unique
  topicFocus               String              @default("[]") // JSON array of strings
  topicAvoid               String              @default("[]") // JSON array of strings
  difficultyOffset         Int                 @default(0)    // clamped -2..+2 by service layer
  contentBoundaries        String              @default("{}") // JSON { disallowedKeywords?: string[]; allowedTags?: string[] }
  dailySessionLimitMinutes Int?
  singleSessionLimitMinutes Int?
  updatedByUserId          String              // audit trail: which parent last touched this
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  // Relations
  child                    ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([updatedByUserId])
  @@map("parent_guidance")
}

model Subscription {
  id                String              @id @default(uuid())
  userId            String              @unique
  plan              String              @default("free")
  storeKitTransactionId String?
  status            String              @default("active")
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model LLMProvider {
  id                String              @id @default(uuid())
  userId            String
  provider          String
  accessTokenEncrypted Bytes
  refreshTokenEncrypted Bytes?
  tokenExpiresAt    DateTime?
  status            String              @default("active")
  connectedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("llm_providers")
}

model LearningPath {
  id                String              @id @default(uuid())
  userId            String
  title             String
  description       String?
  color             String?
  icon              String?
  sortOrder         Int                 @default(0)
  stage             Int                 @default(1)
  isPremium         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons           Lesson[]

  @@index([userId])
  @@map("learning_paths")
}

model Lesson {
  id                String              @id @default(uuid())
  pathId            String?
  userId            String
  title             String
  description       String?
  thumbnailUrl      String?
  difficulty        Int                 @default(1)
  sourceUrl         String?
  aiAnalysis        String?              // JSON stored as text (SQLite compat)
  status            String              @default("draft")
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publishedAt       DateTime?

  // Relations
  path              LearningPath?       @relation(fields: [pathId], references: [id], onDelete: SetNull)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards             Card[]
  assetJobs         AssetJob[]

  @@index([pathId])
  @@index([userId])
  @@index([status])
  @@map("lessons")
}

model Card {
  id                String              @id @default(uuid())
  lessonId          String
  type              String
  sortOrder         Int                 @default(0)
  content           String               // JSON stored as text (SQLite compat)
  voiceScript       String?
  imageUrl          String?
  audioUrl          String?
  interactionConfig String?              // JSON stored as text (SQLite compat)
  conceptId         String?             // S10-02: optional link to a Concept (mastery-bearing cards)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  lesson            Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  interactions      CardInteraction[]
  concept           Concept?            @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([conceptId])
  @@map("cards")
}

model LearningSession {
  id                String              @id @default(uuid())
  childId           String
  deviceId          String?
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  createdAt         DateTime            @default(now())

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  interactions      CardInteraction[]

  @@index([childId])
  @@map("learning_sessions")
}

model CardInteraction {
  id                String              @id @default(uuid())
  sessionId         String
  cardId            String
  action            String
  durationMs        Int
  voiceTranscript   String?
  result            String?              // JSON stored as text (SQLite compat)
  timestamp         DateTime            @default(now())

  // Relations
  session           LearningSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card              Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([cardId])
  @@map("card_interactions")
}

model Badge {
  id                String              @id @default(uuid())
  title             String              @unique
  description       String?
  icon              String?
  criteria          String               // JSON stored as text (SQLite compat)
  createdAt         DateTime            @default(now())

  // Relations
  earnedBadges      EarnedBadge[]

  @@map("badges")
}

model EarnedBadge {
  id                String              @id @default(uuid())
  childId           String
  badgeId           String
  earnedAt          DateTime            @default(now())

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  badge             Badge               @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([childId, badgeId])
  @@index([childId])
  @@index([badgeId])
  @@map("earned_badges")
}

model UrlIngest {
  id                String              @id @default(uuid())
  userId            String
  url               String
  rawContent        String?
  aiAnalysis        String?              // JSON stored as text (SQLite compat)
  status            String              @default("scraped")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("url_ingests")
}

model AssetJob {
  id                String              @id @default(uuid())
  lessonId          String?
  type              String
  input             String               // JSON stored as text (SQLite compat)
  outputUrl         String?
  status            String              @default("queued")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  lesson            Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([status])
  @@map("asset_jobs")
}

model UsageRecord {
  id                String              @id @default(uuid())
  userId            String
  feature           String
  count             Int                 @default(1)
  recordedAt        DateTime            @default(now())

  @@index([userId, feature])
  @@map("usage_records")
}

model LlmUsageLog {
  id                String              @id @default(uuid())
  userId            String
  provider          String              // "openai", "anthropic"
  model             String              // "gpt-4o-mini", "claude-sonnet", "dall-e-3", "tts-1"
  feature           String              // "content_analysis", "card_generation", "sparky_chat", "image_gen", "tts"
  promptTokens      Int                 @default(0)
  completionTokens  Int                 @default(0)
  totalTokens       Int                 @default(0)
  costCents         Float               @default(0) // Cost in cents (USD)
  metadata          String?             // JSON stored as text (SQLite compat)
  createdAt         DateTime            @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([feature])
  @@index([createdAt])
  @@map("llm_usage_logs")
}

model SparkyConversation {
  id                String              @id @default(uuid())
  childId           String
  transcript        String
  response          String
  emotion           String              @default("happy")
  followUpQuestions String?             // JSON stored as text (SQLite compat)
  createdAt         DateTime            @default(now())

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("sparky_conversations")
}

model FeatureFlag {
  id                String              @id @default(uuid())
  key               String              @unique
  enabled           Boolean             @default(false)
  rolloutPercentage Int                 @default(0)
  requiredTier      String?
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("feature_flags")
}

// ============================================================
// Knowledge Graph (Sprint 10 / S10-01 — "The Brain")
// ============================================================
// `Concept` is the domain-level unit of learning (e.g. "Binary numbers",
// "What a loop is"). Concepts live in a DAG via `prerequisites` — a
// JSON-stored array of `Concept.id` values representing dependency edges.
//
// `ChildConcept` is the per-child mastery record. Confidence is a 0..1
// rolling score updated by S10-02 from quiz results. A child has at most
// one `ChildConcept` row per `Concept` (enforced by @@unique).
//
// JSON storage: `prerequisites` is stored as a JSON string because SQLite
// has no native JSON column. The middleware in `client.ts` auto-stringifies
// on write and auto-parses on read — see `JSON_STRING_FIELDS`.
// ============================================================

model Concept {
  id                String              @id @default(uuid())
  name              String              @unique
  domain            String              // "computers" | "robots" | "ai"
  description       String?
  prerequisites     String              @default("[]") // JSON array of concept IDs (stored as text for SQLite)
  difficulty        Int                 @default(1)    // 1-5, rough age-appropriate ordering
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  childConcepts     ChildConcept[]
  cards             Card[]              // S10-02: back-relation for Card.conceptId

  @@index([domain])
  @@index([difficulty])
  @@index([domain, difficulty])
  @@map("concepts")
}

model ChildConcept {
  id                String              @id @default(uuid())
  childId           String
  conceptId         String
  confidence        Float               @default(0.0)  // 0.0 - 1.0
  attempts          Int                 @default(0)
  correctCount      Int                 @default(0)
  lastTested        DateTime?
  firstIntroduced   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  concept           Concept             @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([childId, conceptId])
  @@index([childId])
  @@index([conceptId])
  @@index([childId, confidence])
  @@map("child_concepts")
}
