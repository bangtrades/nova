// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev, switch to "postgresql" for production
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  appleId           String?             @unique
  email             String?             @unique
  displayName       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  childProfiles     ChildProfile[]
  subscription      Subscription?
  llmProviders      LLMProvider[]
  learningPaths     LearningPath[]
  lessons           Lesson[]
  urlIngests        UrlIngest[]

  @@index([appleId])
  @@index([email])
  @@map("users")
}

model ChildProfile {
  id                String              @id @default(uuid())
  userId            String
  name              String
  birthDate         DateTime
  avatarUrl         String?
  currentStage      Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningSessions  LearningSession[]
  earnedBadges      EarnedBadge[]

  @@index([userId])
  @@map("child_profiles")
}

model Subscription {
  id                String              @id @default(uuid())
  userId            String              @unique
  plan              String              @default("free")
  storeKitTransactionId String?
  status            String              @default("active")
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model LLMProvider {
  id                String              @id @default(uuid())
  userId            String
  provider          String
  accessTokenEncrypted Bytes
  refreshTokenEncrypted Bytes?
  tokenExpiresAt    DateTime?
  status            String              @default("active")
  connectedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("llm_providers")
}

model LearningPath {
  id                String              @id @default(uuid())
  userId            String
  title             String
  description       String?
  color             String?
  icon              String?
  sortOrder         Int                 @default(0)
  stage             Int                 @default(1)
  isPremium         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons           Lesson[]

  @@index([userId])
  @@map("learning_paths")
}

model Lesson {
  id                String              @id @default(uuid())
  pathId            String?
  userId            String
  title             String
  description       String?
  thumbnailUrl      String?
  difficulty        Int                 @default(1)
  sourceUrl         String?
  aiAnalysis        Json?
  status            String              @default("draft")
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publishedAt       DateTime?

  // Relations
  path              LearningPath?       @relation(fields: [pathId], references: [id], onDelete: SetNull)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards             Card[]
  assetJobs         AssetJob[]

  @@index([pathId])
  @@index([userId])
  @@index([status])
  @@map("lessons")
}

model Card {
  id                String              @id @default(uuid())
  lessonId          String
  type              String
  sortOrder         Int                 @default(0)
  content           Json
  voiceScript       String?
  imageUrl          String?
  audioUrl          String?
  interactionConfig Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  lesson            Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  interactions      CardInteraction[]

  @@index([lessonId])
  @@map("cards")
}

model LearningSession {
  id                String              @id @default(uuid())
  childId           String
  deviceId          String?
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  createdAt         DateTime            @default(now())

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  interactions      CardInteraction[]

  @@index([childId])
  @@map("learning_sessions")
}

model CardInteraction {
  id                String              @id @default(uuid())
  sessionId         String
  cardId            String
  action            String
  durationMs        Int
  voiceTranscript   String?
  result            Json?
  timestamp         DateTime            @default(now())

  // Relations
  session           LearningSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card              Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([cardId])
  @@map("card_interactions")
}

model Badge {
  id                String              @id @default(uuid())
  title             String              @unique
  description       String?
  icon              String?
  criteria          Json
  createdAt         DateTime            @default(now())

  // Relations
  earnedBadges      EarnedBadge[]

  @@map("badges")
}

model EarnedBadge {
  id                String              @id @default(uuid())
  childId           String
  badgeId           String
  earnedAt          DateTime            @default(now())

  // Relations
  child             ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  badge             Badge               @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([childId, badgeId])
  @@index([childId])
  @@index([badgeId])
  @@map("earned_badges")
}

model UrlIngest {
  id                String              @id @default(uuid())
  userId            String
  url               String
  rawContent        String?
  aiAnalysis        Json?
  status            String              @default("scraped")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("url_ingests")
}

model AssetJob {
  id                String              @id @default(uuid())
  lessonId          String?
  type              String
  input             Json
  outputUrl         String?
  status            String              @default("queued")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  lesson            Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@index([status])
  @@map("asset_jobs")
}
